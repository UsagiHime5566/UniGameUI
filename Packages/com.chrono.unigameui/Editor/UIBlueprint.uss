.workspace-picker {
    min-width: 220px;
    margin-right: 6px;
}

.workspace-picker > .unity-base-field__label {
    min-width: 54px;
}

.blueprint-stage {
    background-color: #222629;
}

.blueprint-edges {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.blueprint-node {
    position: absolute;
    background-color: #343e46;
    border-left-width: 4px;
    border-left-color: #6db8ee;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    padding-bottom: 8px;
}

.popup-node {
    border-left-color: #c39ced;
}

.selected-node {
    background-color: #465662;
}

.node-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #f2f5f7;
    padding-top: 8px;
    padding-left: 9px;
    padding-bottom: 4px;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.node-detail {
    color: #d0dce5;
    font-size: 11px;
    margin-left: 9px;
    margin-right: 15px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.node-port {
    position: absolute;
    width: 12px;
    height: 12px;
    top: 40px;
    right: -5px;
    background-color: #6db8ee;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.popup-node .node-port {
    background-color: #c39ced;
}

.signal-node {
    border-left-color: #f0b35a;
}

.signal-node .node-port {
    background-color: #f0b35a;
}

.edge-label {
    position: absolute;
    color: #e9f1f9;
    background-color: #252d33;
    padding-left: 4px;
    padding-right: 4px;
    font-size: 10px;
}

.blueprint-sidebar {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
}

.sidebar-title {
    height: 27px;
    margin-top: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}
