.workspace-picker {
    min-width: 220px;
    margin-right: 6px;
}

.workspace-picker > .unity-base-field__label {
    min-width: 54px;
}

.blueprint-canvas {
    flex-grow: 1;
    overflow: hidden;
    background-color: #222629;
}

/* 格線與連線：鋪滿畫布區域，不跟著視角縮放。 */
.blueprint-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 節點與線上的標籤：整層跟著視角平移與縮放，子元素用畫布座標排。 */
.blueprint-content {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    transform-origin: left top;
}

/* 範圍框本身沒有底色，虛線是用程式畫的。 */
.blueprint-frame {
    position: absolute;
}

.blueprint-frame-caption {
    position: absolute;
    left: 0;
    top: -24px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    white-space: nowrap;
}

/* 節點：整個節點都可以點選與拖曳。左邊的色條與徽章的顏色表示種類。 */
.blueprint-node {
    position: absolute;
    background-color: #343e46;
    border-left-width: 4px;
    border-left-color: #6db8ee;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    cursor: move-arrow;
}

.blueprint-node:hover {
    background-color: #3d4a54;
    border-top-color: rgba(255, 255, 255, 0.35);
    border-right-color: rgba(255, 255, 255, 0.35);
    border-bottom-color: rgba(255, 255, 255, 0.35);
}

.popup-node {
    border-left-color: #c39ced;
}

.signal-node {
    border-left-color: #f0b35a;
}

.selected-node,
.selected-node:hover {
    background-color: #465662;
    border-top-color: #e8f1f8;
    border-right-color: #e8f1f8;
    border-bottom-color: #e8f1f8;
}

.node-badges {
    flex-direction: row;
    padding-left: 8px;
    padding-top: 7px;
}

/* 徽章：節點、右欄與線上的標籤用同一組顏色。 */
.badge {
    font-size: 10px;
    -unity-font-style: bold;
    color: #11181d;
    background-color: #9aa7b1;
    margin-left: 0;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.badge-page {
    background-color: #6db8ee;
}

.badge-popup {
    background-color: #c39ced;
}

.badge-signal {
    background-color: #f0b35a;
}

.badge-start {
    background-color: #86d48f;
}

.badge-code {
    background-color: #aab6bf;
}

.node-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #f2f5f7;
    padding-top: 5px;
    padding-left: 9px;
    padding-bottom: 0;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.node-id {
    color: #9fb0bd;
    font-size: 11px;
    margin-left: 9px;
    margin-right: 15px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.node-actions {
    color: #d0dce5;
    font-size: 11px;
    margin-left: 9px;
    margin-right: 15px;
    margin-top: 3px;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 連接點：從這裡拖線。 */
.node-port {
    position: absolute;
    width: 12px;
    height: 12px;
    right: -7px;
    background-color: #6db8ee;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    cursor: link;
}

.node-port:hover {
    background-color: #ffffff;
    scale: 1.35 1.35;
}

.popup-node .node-port {
    background-color: #c39ced;
}

.signal-node .node-port {
    background-color: #f0b35a;
}

.popup-node .node-port:hover,
.signal-node .node-port:hover {
    background-color: #ffffff;
}

/* 線上的動作標籤：可以點，點了選取那條路由。 */
.edge-label {
    position: absolute;
    color: #e9f1f9;
    background-color: #252d33;
    border-left-width: 3px;
    border-left-color: #6db8ee;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    padding-left: 4px;
    padding-right: 5px;
    font-size: 10px;
    cursor: link;
}

.edge-popup {
    border-left-color: #c39ced;
}

.edge-label:hover {
    color: #ffffff;
    background-color: #3d4a54;
}

/* 訊號路由的標籤：比較淡，滑鼠移上去或選取「任何畫面」時變清楚。 */
.edge-signal {
    border-left-color: #f0b35a;
    opacity: 0.55;
}

.edge-signal:hover,
.edge-signal.edge-emphasized,
.edge-signal.edge-flash {
    opacity: 1;
}

/* 「任何畫面」節點上的「線已隱藏」標示。 */
.node-hidden-signals {
    font-size: 10px;
    color: #f0d9b0;
    background-color: #5c5346;
    margin-left: 0;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

/* 執行中的藍圖：不能拖曳節點，也沒有連接點。 */
.blueprint-live .blueprint-node {
    cursor: arrow;
}

.blueprint-live .node-port {
    display: none;
}

.live-indicator {
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    color: #11181d;
    background-color: #ffd15c;
    padding-left: 8px;
    padding-right: 8px;
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 2px;
    margin-bottom: 2px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

/* 節點上方的執行中徽章：「目前」、「Popup 1」、「最上層」、「進場中」。 */
.node-live {
    position: absolute;
    left: 0;
    top: -24px;
    flex-direction: row;
}

.node-live .badge {
    font-size: 11px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.badge-live-current {
    background-color: #ffd15c;
}

.badge-live-popup {
    background-color: #d9bdf7;
}

.badge-live-top {
    background-color: #ffffff;
}

.badge-live-transition {
    background-color: #7fe0d0;
}

/* 目前的頁面與開著的 Popup：粗的亮色外框。最上層、可以操作的那一個最亮。 */
.blueprint-node.live-current,
.blueprint-node.live-popup {
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 6px;
}

.blueprint-node.live-current {
    border-top-color: #ffd15c;
    border-right-color: #ffd15c;
    border-bottom-color: #ffd15c;
    border-left-color: #ffd15c;
}

.blueprint-node.live-popup {
    border-top-color: #b48fe0;
    border-right-color: #b48fe0;
    border-bottom-color: #b48fe0;
    border-left-color: #b48fe0;
}

.blueprint-node.live-top {
    background-color: #4f5d68;
}

.blueprint-node.live-popup.live-top {
    border-top-color: #f3e6ff;
    border-right-color: #f3e6ff;
    border-bottom-color: #f3e6ff;
    border-left-color: #f3e6ff;
}

.blueprint-node.live-transition {
    border-top-color: #7fe0d0;
    border-right-color: #7fe0d0;
    border-bottom-color: #7fe0d0;
}

/* 剛走過的路由：線上的標籤亮起來，背景色由程式淡回原本的樣子。 */
.edge-label.edge-flash {
    color: #ffffff;
    border-left-color: #ffe27a;
}

.blueprint-sidebar {
    background-color: #2b2f33;
}

.blueprint-sidebar .unity-scroll-view__content-container {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 12px;
}

/* 右欄的區塊：標題列、邊框、區塊之間的間距。 */
.sidebar-section {
    margin-bottom: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #1c2024;
    border-right-color: #1c2024;
    border-top-color: #1c2024;
    border-bottom-color: #1c2024;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: #33383d;
}

.sidebar-section > .unity-foldout__toggle {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: #24282c;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

.sidebar-section > .unity-foldout__toggle .unity-foldout__text {
    -unity-font-style: bold;
    color: #e6ebef;
}

.sidebar-section > .unity-foldout__content {
    margin-left: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.section-heading {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.sidebar-title {
    font-size: 14px;
    margin-right: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: #f2f5f7;
}

.info-row {
    flex-direction: row;
    margin-top: 2px;
    margin-bottom: 2px;
}

.info-label {
    width: 72px;
    flex-shrink: 0;
    color: #9aa7b1;
}

.info-value {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: #e6ebef;
}

.field-help {
    margin-top: 4px;
    margin-bottom: 4px;
    font-size: 11px;
    white-space: normal;
    color: #9aa7b1;
}

.field-error {
    margin-top: 2px;
    margin-bottom: 4px;
    padding-left: 6px;
    white-space: normal;
    color: #ff8f8f;
    border-left-width: 3px;
    border-left-color: #e05c5c;
}

/* 路由的一列：整列可以點。 */
.route-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-left: 0;
    margin-right: 0;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 8px;
    padding-right: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: #2a2f34;
    border-left-width: 3px;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
    cursor: link;
}

.route-row:hover {
    background-color: #3d4a54;
}

.route-row-selected {
    background-color: #2f4a63;
    border-left-color: #ffd15c;
}

.route-row-selected:hover {
    background-color: #38587a;
}

.route-row-primary {
    margin-right: 8px;
    -unity-font-style: bold;
    color: #f2f5f7;
}

.route-row-secondary {
    flex-shrink: 1;
    color: #c3ccd3;
}

/* 路由種類的徽章：切頁與頁面同色，開啟 Popup 與 Popup 同色，和節點、線上的標籤一致。 */
.kind-ShowPage {
    background-color: #6db8ee;
}

.kind-OpenPopup {
    background-color: #c39ced;
}

.kind-Back {
    background-color: #9aa7b1;
}

.kind-ClosePopup {
    background-color: #e3a0b4;
}

.kind-Emit {
    background-color: #f0b35a;
}

/* 執行中的藍圖：路由的一列加上「觸發」按鈕。 */
.route-row-live {
    flex-direction: row;
    align-items: center;
}

.route-row-live > .route-row {
    flex-grow: 1;
    flex-shrink: 1;
}

.trigger-button {
    margin-left: 4px;
    margin-right: 0;
    min-width: 44px;
}

/* 最近的導航：每一筆一列。結果不是 Completed 的用醒目的顏色。 */
.nav-record {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-left: 0;
    margin-right: 0;
    margin-top: 1px;
    margin-bottom: 1px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    background-color: #2a2f34;
    border-left-width: 3px;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-color: #4c6b52;
    -unity-text-align: middle-left;
}

.nav-record:hover {
    background-color: #3d4a54;
}

.nav-problem {
    background-color: #3d2a2a;
    border-left-color: #e05c5c;
}

.nav-time {
    margin-right: 6px;
    font-size: 10px;
    color: #9aa7b1;
}

.nav-main {
    margin-right: 6px;
    -unity-font-style: bold;
    color: #f2f5f7;
}

.nav-target {
    margin-left: 4px;
    margin-right: 6px;
    color: #c3ccd3;
}

.nav-result {
    color: #9fd8a6;
}

.nav-result-problem {
    -unity-font-style: bold;
    color: #ff8f8f;
}

.route-buttons {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.route-buttons-spacer {
    flex-grow: 1;
    min-width: 16px;
}

/* 刪除：和儲存分開，顏色不同。 */
.danger-button {
    color: #ffb3b3;
    background-color: #5a2a2a;
    border-left-color: #8c3b3b;
    border-right-color: #8c3b3b;
    border-top-color: #8c3b3b;
    border-bottom-color: #8c3b3b;
}

.danger-button:hover {
    color: #ffffff;
    background-color: #8c3030;
}
