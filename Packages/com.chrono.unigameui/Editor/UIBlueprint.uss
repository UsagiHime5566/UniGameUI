.workspace-picker {
    min-width: 220px;
    margin-right: 6px;
}

.workspace-picker > .unity-base-field__label {
    min-width: 54px;
}

.blueprint-canvas {
    flex-grow: 1;
    overflow: hidden;
    background-color: #222629;
}

/* 格線與連線：鋪滿畫布區域，不跟著視角縮放。 */
.blueprint-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 節點與線上的標籤：整層跟著視角平移與縮放，子元素用畫布座標排。 */
.blueprint-content {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    transform-origin: left top;
}

/* 範圍框本身沒有底色，虛線是用程式畫的。 */
.blueprint-frame {
    position: absolute;
}

.blueprint-frame-caption {
    position: absolute;
    left: 0;
    top: -24px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    white-space: nowrap;
}

.blueprint-node {
    position: absolute;
    background-color: #343e46;
    border-left-width: 4px;
    border-left-color: #6db8ee;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    padding-bottom: 8px;
}

.popup-node {
    border-left-color: #c39ced;
}

.selected-node {
    background-color: #465662;
}

.node-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #f2f5f7;
    padding-top: 8px;
    padding-left: 9px;
    padding-bottom: 4px;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.node-detail {
    color: #d0dce5;
    font-size: 11px;
    margin-left: 9px;
    margin-right: 15px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.node-port {
    position: absolute;
    width: 12px;
    height: 12px;
    top: 40px;
    right: -5px;
    background-color: #6db8ee;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.popup-node .node-port {
    background-color: #c39ced;
}

.signal-node {
    border-left-color: #f0b35a;
}

.signal-node .node-port {
    background-color: #f0b35a;
}

.edge-label {
    position: absolute;
    color: #e9f1f9;
    background-color: #252d33;
    padding-left: 4px;
    padding-right: 4px;
    font-size: 10px;
}

.blueprint-sidebar {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
}

.sidebar-title {
    height: 27px;
    margin-top: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}
